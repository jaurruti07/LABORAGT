# LaboraGT Backend - Variables de entorno
PORT=3000
NODE_ENV=development

# JWT
JWT_SECRET=cambiar_por_un_secreto_muy_largo_y_seguro
JWT_EXPIRES_IN=30m
JWT_REFRESH_EXPIRES_IN=7d

# Origen CORS (frontend / admin)
CORS_ORIGIN=*

# Fuente de datos: mock | sheets
# mock  = memoria (demo, se pierde al reiniciar)
# sheets = Google Sheets (persistente)
DATA_SOURCE=mock

# Google Sheets (requerido si DATA_SOURCE=sheets)
GOOGLE_SHEETS_ID=
GOOGLE_SERVICE_ACCOUNT_EMAIL=
# La clave privada puede ir con \n literales en una sola línea
GOOGLE_PRIVATE_KEY=

# Storage de fotografías (opcional en MVP)
PHOTO_STORAGE=local
PHOTO_UPLOAD_DIR=./uploads

# Política de marcaje
ALLOW_OFFLINE_SYNC=true
REJECT_OUTSIDE_LOCATION=false
